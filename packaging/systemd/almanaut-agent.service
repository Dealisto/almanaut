# One-shot inventory agent. Driven by almanaut-agent.timer, never enabled
# directly: a process that lives two seconds cannot leak memory, and its exit
# code lands in the journal where an operator can see it.
#
# Exit codes: 0 accepted, 1 config error, 2 rejected (fix your setup),
# 3 unreachable (transient), 4 conflict (run `almanaut-agent reset-id`).
[Unit]
Description=Report this host's inventory to almanaut
Documentation=https://github.com/Dealisto/almanaut
# Reporting needs the network, but must not block boot if it is late.
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/almanaut-agent

# The agent runs as root because reading DMI and enumerating block devices
# needs it. Everything below narrows what that root can actually touch.
# StateDirectory is what keeps /var/lib/almanaut-agent writable under
# ProtectSystem=strict — without it the agent cannot persist its identity and
# would create a duplicate host on every run.
StateDirectory=almanaut-agent
StateDirectoryMode=0700
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
PrivateDevices=true
ProtectControlGroups=false
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true

# The agent only ever talks to the almanaut server over TCP.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
